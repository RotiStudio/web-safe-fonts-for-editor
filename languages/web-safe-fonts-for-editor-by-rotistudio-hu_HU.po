msgstr "Mintaszöveg"

#. translators: %d: maximum number of characters.
#: web-safe-fonts-for-editor-by-rotistudio.php:589
#, php-format
msgid "Type up to %d characters to see them in every font below. The text is not saved."
msgstr "Írj be legfeljebb %d karaktert, hogy lásd az alábbi betűtípusok mindegyikében. A szöveg nem kerül mentésre."

#: web-safe-fonts-for-editor-by-rotistudio.php:577
msgid "Preload: the font file of a selected font is requested early, in the page head, on the chosen device type. Turn it on only for fonts used on most pages. Desktop devices usually have these fonts installed, so a preload is rarely needed there."
msgstr "Előtöltés: a kiválasztott betűtípus fájlja korán, az oldal fejrészében töltődik be a kiválasztott eszköztípuson. Csak a legtöbb oldalon használt betűtípusoknál kapcsold be. Asztali gépeken ezek a betűtípusok általában telepítve vannak, ezért ott ritkán szükséges."

#: web-safe-fonts-for-editor-by-rotistudio.php:610
msgid "Preload on mobile"
msgstr "Előtöltés mobilon"

#: web-safe-fonts-for-editor-by-rotistudio.php:611
msgid "Preload on desktop"
msgstr "Előtöltés asztali gépen"

#: web-safe-fonts-for-editor-by-rotistudio.php:625
msgid "Font"
msgstr "Betűtípus"

#: web-safe-fonts-for-editor-by-rotistudio.php:626
msgid "Preview"
msgstr "Előnézet"

#: web-safe-fonts-for-editor-by-rotistudio.php:627
msgid "Alternative font"
msgstr "Helyettesítő betűtípus"

#. Description of the plugin
#: web-safe-fonts-for-editor-by-rotistudio.php
msgid "Adds web-safe fonts to the WordPress block editor (Gutenberg), so your website loads faster and looks more consistent."
msgstr "Webbiztos (web-safe) betűtípusok választása a WordPress blokkszerkesztőben (Gutenberg), hogy a weboldalad gyorsabb legyen és egységesebben jelenjen meg."

#: web-safe-fonts-for-editor-by-rotistudio.php:495
#: web-safe-fonts-for-editor-by-rotistudio.php:555
msgid "Web-Safe Fonts"
msgstr "Web-Safe Betűtípusok"

#: web-safe-fonts-for-editor-by-rotistudio.php:572
msgid "Select which web-safe fonts should be available in the WordPress block editor."
msgstr "Válaszd ki, mely web-safe betűtípusok legyenek elérhetők a WordPress blokkszerkesztőben."

