#: web-safe-fonts-for-editor-by-rotistudio.php:556
msgid "Preview text"
msgstr "Mintaszöveg"

#. translators: %d: maximum number of characters.
#: web-safe-fonts-for-editor-by-rotistudio.php:561
#, php-format
msgid "Type up to %d characters to see them in every font below. The text is not saved."
msgstr "Írj be legfeljebb %d karaktert, és az alábbi betűtípusok mindegyikével megjelenik. A szöveget nem mentjük el."

#: web-safe-fonts-for-editor-by-rotistudio.php:549
msgid "Preload: the font file of a selected font is requested early, in the page head, on the chosen device type. Turn it on only for fonts used on most pages. Desktop devices usually have these fonts installed, so a preload is rarely needed there."
msgstr "Előtöltés: a kiválasztott betűtípus fájlja korán, az oldal fejlécében töltődik be a megadott eszköztípuson. Csak a legtöbb oldalon használt betűtípusoknál kapcsold be. Asztali gépeken ezek a betűtípusok általában telepítve vannak, ott ritkán van rá szükség."

#: web-safe-fonts-for-editor-by-rotistudio.php:582
msgid "Preload on mobile"
msgstr "Előtöltés mobilon"

#: web-safe-fonts-for-editor-by-rotistudio.php:583
msgid "Preload on desktop"
msgstr "Előtöltés asztali gépen"

