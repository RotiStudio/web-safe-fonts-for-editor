#. Plugin Name of the plugin
#: web-safe-fonts-for-editor-by-rotistudio.php
msgid "Web-Safe Fonts for Editor by RotiStudio"
msgstr "Web-Safe Betűtípusok a Szerkesztőhöz"

#. Description of the plugin
#: web-safe-fonts-for-editor-by-rotistudio.php
msgid "Add the option to choose web safe fonts in the WordPress block editor (Gutenberg), so your website can be faster and more consistent appearance."
msgstr "Használj biztos, letöltést nem igénylő betűtípust a WordPress blokk szerkesztőben, hogy weboldalad gyorsabb legyen és egységesebb megjelenést adjon."

#: web-safe-fonts-for-editor-by-rotistudio.php:403
msgid "Web Safe Fonts"
msgstr "Web-Safe Betűtípusok"

#: web-safe-fonts-for-editor-by-rotistudio.php:418
msgid "Select which web safe fonts should be available in the WordPress block editor."
msgstr "Válaszd ki, hogy mely betűtípus(oka)t szeretnéd használni a szerkesztőben."

