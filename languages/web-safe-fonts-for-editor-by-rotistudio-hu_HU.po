msgid "Web Safe Fonts"
msgstr "Web-Safe Betűtípusok"

#: web-safe-fonts-for-editor-by-rotistudio.php:381
msgid "Select which web safe fonts should be available in the WordPress block editor."
msgstr "Válaszd ki, hogy mely betűtípus(okat)t szeretnéd használni a szerkesztőben."

